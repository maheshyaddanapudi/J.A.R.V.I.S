{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v setsid >/dev/null 2>&1 && [ -x \"${CLAUDE_PROJECT_DIR:-.}/scripts/graphify-auto-update.sh\" ] && setsid \"${CLAUDE_PROJECT_DIR:-.}/scripts/graphify-auto-update.sh\" > \"${CLAUDE_PROJECT_DIR:-.}/graphify-out/.hook-deep-update.log\" 2>&1 < /dev/null &"
          }
        ]
      }
    ]
  }
}
